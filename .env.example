NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LHDN MyInvois — PLATFORM intermediary credentials (one set for all shops)
# Register Allvisor as Intermediary in MyInvois, then Register ERP under that profile.
# Get Client ID/Secret from https://myinvois.hasil.gov.my (or preprod for sandbox)
LHDN_CLIENT_ID=
LHDN_CLIENT_SECRET=
# intermediary (default, Option A) | taxpayer (single-TIN / self-test only)
LHDN_MODE=intermediary
# Display name shown to shops on LHDN setup steps
LHDN_INTERMEDIARY_NAME=Allvisor
# Optional defaults for UBL document (clinic)
# LHDN_MSIC=86201
# LHDN_MSIC_NAME=Medical and dental practice activities
# sandbox | production
LHDN_ENV=sandbox
