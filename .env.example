NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for Vercel Cron. Any long random string; set the same value in
# the Vercel project settings so the scheduled routes accept the call.
CRON_SECRET=

# AI Supervisor (briefing + owner chat). Any OpenAI-compatible provider works —
# Kimi/Moonshot: https://platform.moonshot.cn (base https://api.moonshot.cn/v1),
# OpenRouter: https://openrouter.ai (base https://openrouter.ai/api/v1),
# Groq: https://console.groq.com (base https://api.groq.com/openai/v1).
# Leave blank and every AI surface falls back to the built-in rule-based text.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=moonshot-v1-8k

# Marketing follow-up emails for /start leads. Leave RESEND_API_KEY blank and no
# mail is ever sent, which is what you want locally.
# Key: https://resend.com/api-keys — the sending domain must be verified first.
RESEND_API_KEY=
# Use a human name, not "noreply". Personal senders get opened.
MARKETING_FROM_EMAIL=Allvisor <hello@yourdomain.com>

# LHDN MyInvois — PLATFORM intermediary credentials (one set for all shops)
# Register Allvisor as Intermediary in MyInvois, then Register ERP under that profile.
# Get Client ID/Secret from https://myinvois.hasil.gov.my (or preprod for sandbox)
LHDN_CLIENT_ID=
LHDN_CLIENT_SECRET=
# intermediary (default, Option A) | taxpayer (single-TIN / self-test only)
LHDN_MODE=intermediary
# Display name shown to shops on LHDN setup steps
LHDN_INTERMEDIARY_NAME=Allvisor
# Optional defaults for UBL document (clinic)
# LHDN_MSIC=86201
# LHDN_MSIC_NAME=Medical and dental practice activities
# sandbox | production
LHDN_ENV=sandbox
